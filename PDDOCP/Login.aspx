<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="PDDOCP.Login" %>
<!DOCTYPE html>
<html><head runat="server"><title>Fitness Tracker Login</title><link href="style.css" rel="stylesheet" /></head><body><form id="form1" runat="server"><div class="page-wrap"><div class="card"><h2>Fitness Tracker - Login</h2><div class="form-grid"><label class="field">Username<asp:TextBox ID="txtName" runat="server" /></label><label class="field">Password<asp:TextBox ID="txtPassword" runat="server" TextMode="Password" MaxLength="12" /></label></div><asp:Button ID="btnLogin" runat="server" Text="Login" OnClick="btnLogin_Click" /> <a href="Register.aspx">Register</a><asp:Label ID="lblMessage" runat="server" CssClass="message" ForeColor="Red" /></div></div></form></body></html>
