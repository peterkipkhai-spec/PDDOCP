<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ManageActivity.aspx.cs" Inherits="PDDOCP.ManageActivity" %>
<!DOCTYPE html>
<html><head runat="server"><title>Manage Activity</title><link href="style.css" rel="stylesheet" /></head><body><form id="form1" runat="server"><div class="page-wrap"><div class="card"><h2>Manage Activities and Metrics</h2><div class="nav"><a href="ManageGoal.aspx">Goals</a><a href="ManageProgress.aspx">Progress</a><asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" /></div><div class="form-grid"><label class="field">Activity Name<asp:TextBox ID="txtActivity" runat="server" /></label><label class="field">Metric Name<asp:TextBox ID="txtMetric" runat="server" /></label><label class="field">Activity<asp:DropDownList ID="ddlActivity" runat="server" /></label><label class="field">Metric<asp:DropDownList ID="ddlMetric" runat="server" /></label><label class="field">Multiplier<asp:TextBox ID="txtMultiplier" runat="server" /></label></div><asp:Button ID="btnAddActivity" runat="server" Text="Add Activity" OnClick="btnAddActivity_Click" /> <asp:Button ID="btnAddMetric" runat="server" Text="Add Metric" OnClick="btnAddMetric_Click" /> <asp:Button ID="btnLink" runat="server" Text="Link Activity Metric" OnClick="btnLink_Click" /><asp:Label ID="lblMessage" runat="server" CssClass="message" ForeColor="Red" /><asp:GridView ID="gvActivityMetric" runat="server" /></div></div></form></body></html>
