<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ManageProgress.aspx.cs" Inherits="PDDOCP.ManageProgress" %>
<!DOCTYPE html>
<html><head runat="server"><title>Manage Progress</title><link href="style.css" rel="stylesheet" /></head><body><form id="form1" runat="server"><div class="page-wrap"><div class="card"><h2>Record Workout Progress</h2><div class="nav"><a href="ManageActivity.aspx">Activities</a><a href="ManageGoal.aspx">Goals</a><asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" /></div><div class="form-grid"><label class="field">Activity<asp:DropDownList ID="ddlActivity" runat="server" AutoPostBack="true" OnSelectedIndexChanged="ddlActivity_SelectedIndexChanged" /></label><label class="field">Value 1<asp:TextBox ID="txtValue1" runat="server" /></label><label class="field">Value 2<asp:TextBox ID="txtValue2" runat="server" /></label><label class="field">Value 3<asp:TextBox ID="txtValue3" runat="server" /></label></div><asp:Button ID="btnRecord" runat="server" Text="Calculate and Record" OnClick="btnRecord_Click" /><asp:Label ID="lblMessage" runat="server" CssClass="message" ForeColor="Red" /><div class="status">Total Calories: <asp:Label ID="lblTotal" runat="server" /> | Target: <asp:Label ID="lblTarget" runat="server" /> | <asp:Label ID="lblGoalStatus" runat="server" /></div><asp:GridView ID="gvProgress" runat="server" /></div></div></form></body></html>
