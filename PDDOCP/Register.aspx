<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Register.aspx.cs" Inherits="PDDOCP.Register" %>
<!DOCTYPE html>
<html><head runat="server"><title>Register</title><link href="style.css" rel="stylesheet" /></head><body><form id="form1" runat="server"><div class="page-wrap"><div class="card"><h2>Register Member</h2><div class="form-grid"><label class="field">Username (alphanumeric only)<asp:TextBox ID="txtName" runat="server" /></label><label class="field">Password (exactly 12 chars, upper and lower case)<asp:TextBox ID="txtPassword" runat="server" TextMode="Password" MaxLength="12" /></label></div><asp:Button ID="btnRegister" runat="server" Text="Register" OnClick="btnRegister_Click" /> <a href="Login.aspx">Login</a><asp:Label ID="lblMessage" runat="server" CssClass="message" ForeColor="Red" /></div></div></form></body></html>
